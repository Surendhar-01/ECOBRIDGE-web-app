# ECOBRIDGES FastAPI AI Service — template. Copy to .env and fill real values.
# NEVER put real secrets in this file.

# Speech-to-text. Keep false on small hosts (a Render free instance has 512 MB):
# downloading and loading the model can exceed that limit. The multilingual NLP
# intent layer works regardless, and that is what the NestJS bridge calls.
WHISPER_ENABLED=false
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Load at startup instead of on first transcription (slower boot, no first-request delay).
WHISPER_EAGER_LOAD=false

# xAI Grok (https://console.x.ai) — paste key into .env, never here
GROK_API_KEY=
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4

# Supabase (paste values from Supabase Project Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ECOBRIDGES NestJS Backend — template. Copy to .env and fill real values.
# NEVER put real secrets in this file.

PORT=3000

# Supabase (paste values from Supabase Project Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct PostgreSQL connection. Server-side only.
DATABASE_URL=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres

# Groq AI. Server-side only; never expose this in Vite variables.
GROQ_API_KEY=

# xAI Grok (https://console.x.ai) — paste key into .env, never here
GROK_API_KEY=
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4

# URL of the FastAPI voice/AI service
FASTAPI_VOICE_URL=http://localhost:8000

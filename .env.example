# GROQ_API_KEY: Groq AI API key (https://console.groq.com/keys). This replaces
# the previous Gemini integration and is used for voice-intent understanding.
# The value below is a placeholder, so the app falls back to the on-device
# semantic engine until a real key is supplied.
GROQ_API_KEY=MY_GROQ_API_KEY

# GROQ_TEXT_MODEL: chat model used for voice-intent parsing (text only).
GROQ_TEXT_MODEL=DEFAULT_GROQ_TEXT_MODEL

# GROQ_VISION_MODEL: optional vision model for photographed-lot analysis.
#
# Leave this empty unless a vision-capable model is enabled on your Groq
# account. Posting an image to a text-only model fails with
# "messages[0].content must be a string". While empty, the camera scanner uses
# its deterministic on-device visual analysis, which needs no network and no
# key -- so lot creation keeps working fully offline.
GROQ_VISION_MODEL=

# MAPS_API_KEY: Required for Google Maps SDK.
MAPS_API_KEY=DEFAULT_MAPS_API_KEY

# SUPABASE_URL: Your Supabase project URL, e.g. https://xyzcompany.supabase.co
# SUPABASE_ANON_KEY: Public anon/public key from Supabase Project Settings -> API.
# Until real values are provided, all real auth flows surface an honest
# "Auth provider not configured" error (no simulated success).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# GOOGLE_WEB_CLIENT_ID: OAuth 2.0 Web client id used for Google Sign-In via
# Credential Manager (id_token is exchanged with Supabase Sign In With ID Token).
GOOGLE_WEB_CLIENT_ID=

# OTP_MODE: "demo" = on-device Demo OTP second factor after credential sign-in
# (shown in the app, no SMS). "sms" = real provider (see issuePendingOtp hook).
OTP_MODE=demo

# GROK_API_KEY: xAI Grok API key (https://console.x.ai).
# Copy your key into .env as GROK_API_KEY=... (never commit the real key).
GROK_API_KEY=
# XAI_API_KEY is an alias — official xAI SDKs expect this name.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4

